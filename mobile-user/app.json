{
  "expo": {
    "name": "Hoomzo",
    "slug": "hoomzo-user",
    "scheme": "hoomzo",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hoomzo.user"
    },
    "android": {
      "package": "com.hoomzo.user",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#0032C7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hoomzo to access your photos to upload property images and profile pictures.",
          "cameraPermission": "Allow Hoomzo to use the camera to take property and document photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hoomzo to use your location to show properties near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#005CA8"
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#0032C7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://hoomzo.com/api",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0a6848a0-609a-4ad5-9073-b9f2f546734b"
      }
    },
    "owner": "asif_mansoori"
  }
}
